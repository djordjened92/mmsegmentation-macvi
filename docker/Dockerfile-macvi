# Use CUDA 11.6 with Ubuntu 20.04
FROM nvcr.io/nvidia/cuda:11.6.2-cudnn8-devel-ubuntu20.04

# Avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Update pip and set as default python
RUN ln -s /usr/bin/python3 /usr/bin/python
RUN pip install --upgrade pip

# 1. Install PyTorch 1.12.1 for CUDA 11.6
RUN pip install torch==1.12.1+cu116 torchvision==0.13.1+cu116 --extra-index-url https://download.pytorch.org/whl/cu116

# 2. Install MMCV-Full 1.6.2
# We use the official pre-built wheel to avoid the libtorch_cuda_cu.so errors
RUN pip install mmcv-full==1.6.2 -f https://download.openmmlab.com/mmcv/dist/cu116/torch1.12.0/index.html

# 3. Install other requirements
RUN pip install mmcls==0.25.0 opencv-python matplotlib
RUN pip install future tensorboard

WORKDIR /workspace

# 3. Install mmseg from mmsegmentation-macvi
COPY . .

RUN pip install --no-cache-dir -e .

RUN pip install -r requirements.txt

ENV CUDA_VISIBLE_DEVICES=0